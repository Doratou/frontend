# Public build-time configuration. Never put secrets in VITE_* variables.
# Use a reverse proxy for /api, or set an absolute backend URL (including its API prefix).
VITE_API_BASE_URL=/api
# Enable only after agreeing cookie authentication and CORS/CSRF with the backend.
VITE_API_WITH_CREDENTIALS=false
# Enable only when the backend implements docs/auth-api-contract.md.
VITE_AUTH_API_ENABLED=false
