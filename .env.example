# Public build-time configuration. Never put secrets in VITE_* variables.
# Placeholder only. Replace with the backend URL including /api/v1.
VITE_API_BASE_URL=https://api.example.invalid/api/v1
# Bruno Auth uses Bearer tokens, not cross-origin cookies.
VITE_API_WITH_CREDENTIALS=false
# Set false only to use the development-only sample adapter.
VITE_AUTH_API_ENABLED=true
# Bruno's send response has no code length; its OTP examples use 5 digits.
VITE_AUTH_OTP_LENGTH=5
